# Email Configuration for Weekly Reports
# Copy these to your .env file and configure with your SendGrid settings

# SendGrid API Configuration (Recommended)
SENDGRID_API_KEY=your_sendgrid_api_key_here

# From Email Details (must be verified in SendGrid)
FROM_EMAIL=noreply@yourdomain.com
FROM_NAME=AI Learning Platform

# Instructions for SendGrid Setup:
# 1. Go to https://sendgrid.com and create a free account
# 2. Verify your sender identity (domain or single sender)
# 3. Create an API key with Mail Send permissions
# 4. Add the API key to your .env file as SENDGRID_API_KEY
# 5. Update FROM_EMAIL to match your verified sender

# SendGrid Free Plan includes:
# - 100 emails per day
# - Advanced analytics and tracking
# - Better delivery rates than SMTP
# - Easy setup and configuration
